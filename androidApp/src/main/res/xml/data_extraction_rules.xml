<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: conversations (database) and Recordings (audio/) never leave the device,
     neither to cloud backup nor in a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dovashi.db" />
        <exclude domain="database" path="dovashi.db-journal" />
        <exclude domain="database" path="dovashi.db-wal" />
        <exclude domain="database" path="dovashi.db-shm" />
        <exclude domain="file" path="audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dovashi.db" />
        <exclude domain="database" path="dovashi.db-journal" />
        <exclude domain="database" path="dovashi.db-wal" />
        <exclude domain="database" path="dovashi.db-shm" />
        <exclude domain="file" path="audio/" />
    </device-transfer>
</data-extraction-rules>
