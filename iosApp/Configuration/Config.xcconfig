TEAM_ID=

PRODUCT_NAME=DoVashiApp
PRODUCT_BUNDLE_IDENTIFIER=com.example.dovashiapp.DoVashiApp$(TEAM_ID)
INFOPLIST_KEY_CFBundleDisplayName=Bilangual

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// The static Shared framework leaves SQLite to the app link (SQLDelight native driver).
OTHER_LDFLAGS=$(inherited) -lsqlite3

// The OpenAI key is never committed: put `OPENAI_API_KEY = sk-…` in the git-ignored Secrets.xcconfig (see README).
OPENAI_API_KEY =
#include? "Secrets.xcconfig"
