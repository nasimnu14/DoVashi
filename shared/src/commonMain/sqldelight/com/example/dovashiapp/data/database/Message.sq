CREATE TABLE Message (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    conversationId INTEGER NOT NULL REFERENCES Conversation(id),
    sourceLanguage TEXT,
    targetLanguage TEXT,
    audioPath TEXT,
    transcribedText TEXT,
    translatedText TEXT,
    reading TEXT,
    status TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE INDEX message_conversation_created ON Message(conversationId, createdAt);

insertMessage:
INSERT INTO Message(
    conversationId, sourceLanguage, targetLanguage, audioPath,
    transcribedText, translatedText, reading, status, createdAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByConversation:
SELECT * FROM Message
WHERE conversationId = ?
ORDER BY createdAt DESC, id DESC;

selectById:
SELECT * FROM Message WHERE id = ?;

selectConversationId:
SELECT conversationId FROM Message WHERE id = ?;

-- Each step write only applies from its allowed previous statuses (see MessageStep).
updateStatus:
UPDATE Message SET status = :status
WHERE id = :id AND status IN :allowed;

saveTranscription:
UPDATE Message
SET transcribedText = :transcribedText, sourceLanguage = :sourceLanguage, targetLanguage = :targetLanguage, status = :status
WHERE id = :id AND status IN :allowed;

startTranscription:
UPDATE Message SET status = :status
WHERE id = :id AND status IN :allowed AND audioPath IS NOT NULL;

retryTranslation:
UPDATE Message SET status = :status
WHERE id = :id AND status IN :allowed
  AND transcribedText IS NOT NULL AND sourceLanguage IS NOT NULL AND targetLanguage IS NOT NULL;

saveTranslation:
UPDATE Message
SET translatedText = :translatedText, reading = :reading, status = :status
WHERE id = :id AND status IN :allowed;

-- Discards an accidental or failed Recording; never touches a Message that has moved on.
deleteRecording:
DELETE FROM Message WHERE id = :id AND status = :recordingStatus;

-- Startup sweep: nothing can still be working on these after a restart.
selectInterruptedRecordings:
SELECT audioPath FROM Message WHERE status = :recordingStatus AND audioPath IS NOT NULL;

deleteInterruptedRecordings:
DELETE FROM Message WHERE status = :recordingStatus;

failInterrupted:
UPDATE Message SET status = :failedStatus WHERE status IN :interrupted;
